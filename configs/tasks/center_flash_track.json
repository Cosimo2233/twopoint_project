{
  "mode": "center_flash_track",
  "camera": {
    "index": 0,
    "width": 640,
    "height": 480,
    "fps": 30
  },
  "f32c": {
    "port": "/dev/ttyAS4",
    "baudrate": 115200,
    "x_id": 1,
    "y_id": 2,
    "speed_rpm": 100,
    "startup_delay": 0.3,
    "command_interval": 0.001,
    "enable_settle_delay": 0.2,
    "debug_frames": false
  },
  "center": {
    "conf_threshold": 0.0,
    "target_x": 0.5,
    "target_y": 0.5,
    "pid": {
      "x": {
        "kp": -12.0,
        "ki": 0.0,
        "kd": 2.0,
        "integral_limit": 0.2,
        "output_limit_deg": 90.0
      },
      "y": {
        "kp": 12.0,
        "ki": 0.0,
        "kd": 2.0,
        "integral_limit": 0.2,
        "output_limit_deg": 90.0
      }
    },
    "deadband": 0.006,
    "loop_hz": 15.0,
    "stale_target_seconds": 0.3,
    "stale_target_step_scale": 0.0,
    "timeout": 100.0,
    "stable_frames": 3
  },
  "laser": {
    "hold_seconds": 5.0,
    "on_during_run": true
  },
  "behavior": {
    "fire_after_timeout": true,
    "exit_after_fire": false
  },
  "recording": {
    "save_raw_video": true
  }
