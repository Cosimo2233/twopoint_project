{
  "mode": "center_flash_track",
  "f32c": {
    "port": "/dev/ttyAS4",
    "baudrate": 115200,
    "x_id": 1,
    "y_id": 2,
    "speed_rpm": 100,
    "startup_delay": 0.3,
    "command_interval": 0.001,
    "enable_settle_delay": 0.2,
    "debug_frames": false
  },
  "center": {
    "conf_threshold": 0.0,
    "target_x": 0.5,
    "target_y": 0.5,
    "pid": {
      "x": {
        "kp": 10.0,
        "ki": 0.1,
        "kd": 1.0,
        "integral_limit": 0.2,
        "output_limit_deg": 30.0,
        "integral_separation_threshold": 0.04,
        "derivative_separation_threshold": 0.12,
        "fuzzy_enabled": true,
        "fuzzy_error_low": 0.02,
        "fuzzy_error_high": 0.20,
        "fuzzy_kp_near_scale": 0.75,
        "fuzzy_kp_far_scale": 1.25
      },
      "y": {
        "kp": -10.0,
        "ki": -0.1,
        "kd": -3.0,
        "integral_limit": 0.2,
        "output_limit_deg": 30.0,
        "integral_separation_threshold": 0.04,
        "derivative_separation_threshold": 0.12,
        "fuzzy_enabled": true,
        "fuzzy_error_low": 0.02,
        "fuzzy_error_high": 0.20,
        "fuzzy_kp_near_scale": 0.75,
        "fuzzy_kp_far_scale": 1.25
      }
    },
    "feedforward": {
      "enabled": true,
      "lead_time": 0.12,
      "max_prediction_error": 0.06,
      "max_velocity": 1.2,
      "velocity_alpha": 0.6
    },
    "deadband": 0.006,
    "loop_hz": 15.0,
    "stale_target_seconds": 0.3,
    "stale_target_step_scale": 0.0,
    "timeout": 100.0,
    "stable_frames": 3
  },
  "laser": {
    "hold_seconds": 5.0,
    "on_during_run": true
  },
  "behavior": {
    "fire_after_timeout": true,
    "exit_after_fire": false
  },
  "recording": {
    "save_raw_video": true
  }
