{
  "mode": "center_flash_track",
  "camera": {
    "index": 0,
    "width": 640,
    "height": 480,
    "fps": 30
  },
  "f32c": {
    "port": "/dev/ttyAS4",
    "baudrate": 115200,
    "x_id": 1,
    "y_id": 2,
